# Wajib untuk produksi
# Secret untuk melindungi endpoint cron (dipakai Vercel Cron / scheduler eksternal)
CRON_SECRET=ganti-dengan-string-acak-panjang
# URL publik situs (untuk tautan di email)
BASE_URL=http://localhost:3000
# Database: kosongkan untuk SQLite default (data/lensa.db), isi untuk pakai Postgres
# Contoh: postgresql://user:pass@host:5432/lensa
DATABASE_URL=

# Analisis AI (opsional - tanpa ini, analisis pakai heuristik)
# Kompatibel dengan API OpenAI: OpenAI, OpenRouter, Groq, DeepSeek, dll.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email digest & magic link (opsional - tanpa ini, email dicetak ke konsol)
RESEND_API_KEY=
MAIL_FROM=Lensa <onboarding@resend.dev>

# Catatan deploy:
# - Vercel Hobby hanya mengizinkan cron harian. Untuk interval lebih sering,
#   pakai scheduler eksternal (cron-job.org, GitHub Actions):
#   curl -H "Authorization: Bearer $CRON_SECRET" https://domainmu/api/cron/ingest
# - SQLite default: data/lensa.db (ephemeral di Vercel!). Untuk produksi,
#   set DATABASE_URL ke Postgres (Supabase/Neon) - skema kompatibel.
